# Copy to .env only if you want to change something. Every value below has a
# working default, and the system runs with this file absent entirely.

# local — uploads on, no limits, your own papers (default)
# demo  — uploads off, fixed corpus; what the public deployment runs
RESEARCHLENS_MODE=local

# The default generator. Nothing else is required for a working system.
OLLAMA_MODEL=qwen2.5:3b-instruct

# Optional hosted provider. Leave blank and the local model serves everything.
# On the public demo these are held by the Cloudflare Worker in front, never by
# the container and never by the page.
HOSTED_BASE_URL=
HOSTED_API_KEY=
HOSTED_MODEL=claude-sonnet-5
